*.key

# 3. Python Çalışma Zamanı ve Önbellekler
__pycache__/
*.py[cod]
*$py.class
backend/vendor/
.pytest_cache/

# 4. İşletim Sistemi ve IDE Dosyaları
.DS_Store
Thumbs.db
.vscode/
.idea/


