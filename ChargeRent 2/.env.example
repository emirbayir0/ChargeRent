# ChargeRent Örnek Yapılandırma Dosyası (.env.example)
# Bu dosyayı .env adıyla kopyalayıp kendi anahtarlarınızı belirleyin.
# Gerçek gizli anahtarları kesinlikle Git deposuna eklemeyin.

# JWT imzalama anahtarı (en az 32 karakterlik karmaşık bir metin olmalıdır)
SECRET_KEY=BURAYA_EN_AZ_32_KARAKTERLIK_RASTGELE_GIZLI_ANAHTAR_GIRIN

# Backend API port numarası
API_PORT=8000

# CORS için izin verilen kök adresler (virgülle ayırarak birden fazla eklenebilir)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:3034,https://app.chargerent.example.com

# Frontend'in bağlandığı API temel adresi
API_BASE_URL=http://localhost:8000

# Demo Girişi (/api/demo-login) Açık/Kapalı Ayarı (true/false, varsayılan: false)
DEMO_MODE=false

# Güvenilir ters vekil sunucu desteği (X-Forwarded-For IP doğrulaması, varsayılan: false)
TRUSTED_PROXY=false

COOKIE_SECURE=false
